generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id       String  @id @default(cuid())
  name     String
  email    String  @unique
  password String?

  // Account verification. This flag — never "password is null" — is what
  // "verified" means. Google sign-in (web callback and native token exchange)
  // sets it; phone OTP will set this same flag when it lands, and nothing
  // downstream will need to change. Flipping it false -> true is what triggers
  // the VERIFY_ACCOUNT award and the one-time signup grant; see markVerified().
  isVerified Boolean @default(false)

  // One-time signup grant (SIGNUP_GRANT_LEAVES), claimed at verification, never
  // at registration — an ungated grant lets an attacker mint Leaves by mass-
  // creating accounts. Set true in the SAME statement that credits the Leaves,
  // so two concurrent verifications cannot both pay out.
  signupGrantClaimed Boolean @default(false)

  avatar      String?
  bio         String?  @db.Text
  location    String?
  rating      Float    @default(0)
  totalTrades Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Account deletion (DELETE /api/user). The row is ANONYMISED here, never
  // removed, and that is a ledger decision rather than a soft-delete habit:
  // LeafTransaction.userId is a foreign key with onDelete: Cascade, so dropping
  // the row would silently delete that user's ledger history and break
  // SUM(User.leaves) == SUM(LeafTransaction.amount) — the one invariant the
  // whole Leaf economy is checked against. Retiring the account keeps both
  // sides of that equation intact while the personal data is scrubbed.
  //
  // Non-null means gone: resolveSession() refuses these accounts, so an access
  // token issued before deletion stops working immediately.
  deletedAt DateTime?

  items                   Item[]
  sentRequests            TradeRequest[]           @relation("SentRequests")
  receivedRequests        TradeRequest[]           @relation("ReceivedRequests")
  sentMessages            Message[]                @relation("SentMessages")
  receivedMessages        Message[]                @relation("ReceivedMessages")
  notifications           Notification[]           @relation("NotificationRecipient")
  triggeredNotifications  Notification[]           @relation("NotificationActor")
  reviewsGiven            Review[]                 @relation("ReviewsGiven")
  reviewsReceived         Review[]                 @relation("ReviewsReceived")
  following               Follow[]                 @relation("Follower")
  followers               Follow[]                 @relation("Followee")
  postLikes               PostLike[]               @relation("UserPostLikes")
  postComments            PostComment[]            @relation("UserPostComments")
  commentLikes            CommentLike[]            @relation("UserCommentLikes")
  sentOffers              Offer[]                  @relation("SentOffers")
  receivedOffers          Offer[]                  @relation("ReceivedOffers")
  leaves                  Int                      @default(0)
  lifetimeLeaves          Int                      @default(0)
  leafTransactions        LeafTransaction[]
  swapConfirmationCodes   SwapConfirmationCode[]
  taskCompletions         TaskCompletion[]
  refreshTokens           RefreshToken[]
  emailVerificationTokens EmailVerificationToken[]

  // Deferred Points Agreements. No denormalised default counter and no
  // defaulted flag on this row on purpose: both are derived from these two
  // relations at read time. A stored counter is one more thing that can drift
  // out of step with the rows it summarises -- totalTrades above already has,
  // sitting one and two above the real COMPLETED trade count for two users --
  // and a derived penalty is one that a lazy deadline sweep cannot apply twice.
  contractsAsDebtor   DeferredContract[] @relation("ContractDebtor")
  contractsAsCreditor DeferredContract[] @relation("ContractCreditor")

  // ── Moderation ─────────────────────────────────────────────────────────────
  //
  // The first privileged concept in this codebase. Every other authorisation
  // decision here is ownership-based -- you may edit an item because it is your
  // item -- and that shape cannot express "may act on someone else's content",
  // which is the whole job of a moderator.
  //
  // NO API ROUTE WRITES THIS COLUMN. Not an admin-only one, not a
  // super-admin-only one, none. An endpoint that can grant ADMIN is a
  // privilege-escalation target whose entire value is saving somebody a SQL
  // prompt once a year, and the escalation is total: an ADMIN can suspend every
  // account including the ones that would notice. Promotion is:
  //
  //   UPDATE `User` SET `role` = 'ADMIN' WHERE `email` = '...';
  //
  // Enforced by absence, and by scripts/verify-moderation.ts, which greps the
  // route tree for any handler that reads `role` out of a request body.
  role Role @default(USER)

  // Account suspension, written only by POST /api/admin/users/[id] with
  // action "suspend" / "unsuspend".
  //
  // suspendedAt     non-null means suspended right now.
  // suspendedUntil  when it lifts. NULL WITH suspendedAt SET MEANS INDEFINITE --
  //                 not "already lifted". suspensionState() in @/lib/moderation
  //                 is the only correct reading of the pair; do not test either
  //                 column alone.
  //
  // Both are CLEARED on unsuspend rather than kept as history. That is the
  // opposite of DeferredContract.defaultedAt, and deliberately so: a default is
  // a fact about the debtor that the tier system keeps charging against, while a
  // lifted suspension is a moderation decision whose record belongs in
  // AdminAction, next to who lifted it and why. A suspension history smeared
  // across the User row would be a second, worse audit log.
  suspendedAt    DateTime?
  suspendedUntil DateTime?

  reportsMade     Report[]      @relation("ReportReporter")
  reportsResolved Report[]      @relation("ReportResolver")
  blocksMade      Block[]       @relation("Blocker")
  blocksReceived  Block[]       @relation("Blocked")
  adminActions    AdminAction[] @relation("AdminActor")
}

model Follow {
  id        String       @id @default(cuid())
  status    FollowStatus @default(PENDING)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  followerId String
  follower   User   @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followeeId String
  followee   User   @relation("Followee", fields: [followeeId], references: [id], onDelete: Cascade)

  @@unique([followerId, followeeId])
}

// Refresh tokens for the native (React Native) client. The web admin side keeps
// its NextAuth cookie session and never touches this table.
//
// Three properties do the security work, and none of them is optional:
//   HASHED     — only the SHA-256 of the token is stored, so a database read
//                does not hand out usable credentials.
//   SINGLE USE — `usedAt` is stamped the first time a token is redeemed.
//                Redeeming it again is, by definition, either a replay or a
//                thief racing the legitimate client.
//   FAMILY     — every token minted from the same original login shares a
//                `familyId`. A replay revokes the WHOLE family, which logs out
//                both the thief and the victim rather than letting the thief
//                quietly keep rotating. That is the intended, safe outcome.
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  familyId  String
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([userId])
  // familyId is not decoration: revoking a family on replay looks up by it.
  @@index([familyId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// Email verification for credentials signup.
//
// Same shape as PasswordResetToken with one deliberate difference: only the
// SHA-256 of the token is stored. A reset token in the clear is already a
// weakness in that table; there is no reason to reproduce it here, and hashing
// costs a single digest on a path that runs once per account.
//
// Four properties do the work:
//   HASHED     — a database read yields no usable verification link.
//   EXPIRING   — 24 hours, checked on every redemption.
//   SINGLE USE — the row is deleted the moment it is redeemed, so a link that
//                leaks from a mailbox later is inert.
//   ONE LIVE   — issuing purges any prior token for that user, so a resend
//                invalidates the previous email rather than leaving a fleet of
//                working links behind.
//
// Keyed on userId rather than email: the account is what gets verified, and an
// email change must not leave a token that verifies the new address using proof
// of the old one.
model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Item {
  id          String     @id @default(cuid())
  title       String
  description String     @db.Text
  images      String     @db.Text
  category    Category
  condition   Condition
  // The FINAL value: what the owner is asking, after any override they made.
  // This is the number every other surface reads. It is bounded server-side to
  // OVERRIDE_BAND_PCT either side of suggestedLeaves (see @/lib/valuation).
  valueLeaves Int?

  // The valuation model's own number, before the owner touched it. Stored
  // alongside the final value rather than instead of it so the divergence
  // between what the model said and what people listed at is MEASURABLE:
  //   SELECT AVG((valueLeaves - suggestedLeaves) / suggestedLeaves) FROM Item
  //   WHERE suggestedLeaves IS NOT NULL;
  // NULL means the listing predates the valuation system (see the 2026-08-25
  // migration) — it does not mean "no suggestion was made".
  suggestedLeaves Int?

  // Which path produced suggestedLeaves: "comparables" or "category_band",
  // exactly those strings. A plain VARCHAR and not an enum on purpose: the same
  // two literals go out on the wire, and a wire value generated from a DB enum
  // name is one that changes the day someone renames the enum. The writable set
  // is closed in code by VALUATION_SOURCES in @/lib/valuation.
  //
  // This column exists to answer one question with a query instead of a guess:
  // how many listings were valued from real Baylo trade history rather than the
  // fallback band table.
  valuationSource String? @db.VarChar(32)

  // Re-valuations already spent on this listing. Capped at MAX_REVALUATIONS.
  // The model is deterministic, so re-running it on unchanged inputs returns
  // the identical number; the only way a repeat request moves the suggestion is
  // if the category or condition was edited. One correction is allowed, then
  // the listing is done shopping for a friendlier number.
  revaluationCount Int @default(0)

  status      ItemStatus @default(AVAILABLE)

  // Free text only: what the owner wants in return. This column used to double
  // as a JSON envelope carrying the pickup coordinates, which is how a home
  // address ended up being served to unauthenticated callers — a field named
  // "wanted items" is not somewhere anyone thinks to look for location data.
  // Pickup now lives in the three explicit columns below and is filtered by
  // resolvePickup() in @/lib/item-visibility on every read path.
  wantedItems String? @db.Text

  // Exact pickup point. NEVER serialise these straight onto a response: full
  // precision plus pickupAddress identifies a seller's home. Only the owner and
  // an accepted trade counterparty may see them; everyone else gets the
  // 2-decimal-place (~1 km) rounding that resolvePickup() applies.
  pickupLat     Float?
  pickupLng     Float?
  pickupAddress String? @db.Text

  // Moderator takedown. NULL means "not hidden by us"; non-null is the moment a
  // moderator removed it, and the who/why lives in the AdminAction row written
  // in the same transaction.
  //
  // A SEPARATE COLUMN AND NOT `status = REMOVED`, for one concrete reason: the
  // owner can already move their own item in and out of REMOVED/OWNED/AVAILABLE
  // -- POST /api/items/[id]/relist does exactly that -- so a takedown expressed
  // as a status would be undoable by the person it was aimed at. Every read path
  // filters on `moderationHiddenAt: null` in the WHERE clause, and relist
  // refuses while it is set.
  moderationHiddenAt DateTime?

  imageHash String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  offeredIn   TradeRequest[] @relation("OfferedItem")
  requestedIn TradeRequest[] @relation("RequestedItem")
  likes       PostLike[]     @relation("ItemPostLikes")
  comments    PostComment[]  @relation("ItemPostComments")
  offers      Offer[]        @relation("ItemOffers")
}

model TradeRequest {
  id        String      @id @default(cuid())
  status    TradeStatus @default(PENDING)
  message   String?     @db.Text
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  hiddenBySender   Boolean @default(false)
  hiddenByReceiver Boolean @default(false)
  safeZoneMeetup   Boolean @default(false)

  senderId   String
  sender     User   @relation("SentRequests", fields: [senderId], references: [id])
  receiverId String
  receiver   User   @relation("ReceivedRequests", fields: [receiverId], references: [id])

  offeredItemId   String
  offeredItem     Item   @relation("OfferedItem", fields: [offeredItemId], references: [id])
  requestedItemId String
  requestedItem   Item   @relation("RequestedItem", fields: [requestedItemId], references: [id])

  // Leaves moving from sender to receiver as part of this trade. NULL means
  // none — the same thing the `?? 0` at each old recovery site meant.
  //
  // This is recorded ON the trade rather than recovered from the Offer that
  // produced it. The old correlation (senderId + postId + status ACCEPTED) is
  // not unique: five trades match more than one accepted offer, one matches
  // eight, and one sender/post pair holds two different amounts (100 and 200).
  // Settlement resolved that with findFirst() and no orderBy, so the amount it
  // debited was whichever row the optimiser returned. Settlement is the one
  // code path that moves currency; it does not get to guess.
  offeredLeaves Int?

  messages              Message[]
  reviews               Review[]
  swapConfirmationCodes SwapConfirmationCode[]
  deferredContracts     DeferredContract[]
}

model Message {
  id        String   @id @default(cuid())
  content   String   @db.Text
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  senderId   String
  sender     User   @relation("SentMessages", fields: [senderId], references: [id])
  receiverId String
  receiver   User   @relation("ReceivedMessages", fields: [receiverId], references: [id])

  tradeId String?
  trade   TradeRequest? @relation(fields: [tradeId], references: [id])
}

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  message   String
  read      Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())

  // Structured navigation target, kept SEPARATE from `type`.
  //
  // `type` is the EVENT that happened; entityType/entityId are WHAT TO OPEN.
  // They do not map one-to-one — TRADE_ACCEPTED and NEW_MESSAGE both point at a
  // chat partner, while TRADE_COMPLETED points at a list with no id at all.
  // Collapsing the two is the mismatch that bites later.
  //
  // entityType is a plain string, not an enum: the set of navigable targets
  // grows with the mobile client and each addition would otherwise cost a
  // schema migration for what is just a routing token.
  //
  // TWO VOCABULARIES LIVE IN THIS COLUMN. That is deliberate, and knowing which
  // one a row uses is a matter of when it was written.
  //
  //   v1 and later (what new writes use) — the fine-grained set:
  //     "conversation"   entityId = the other participant's userId
  //     "trade"          entityId = the tradeId
  //     "review"         entityId = the reviewId
  //     "follow_request" entityId = null
  //     "report"         entityId = the reportId (REPORT_RESOLVED)
  //
  //   pre-v1 (the migrated rows) — a coarse set the old `link` column could
  //   actually support:
  //     "user"   entityId = a userId, or null
  //     "trade"  entityId = ALWAYS null
  //
  // The distinction that matters is "conversation" vs "user": a notification
  // about a message opens a THREAD WITH someone, not their profile. The old
  // links could not express that difference, which is why the backfill could
  // not either.
  //
  // CAVEAT ON PRE-v1 ROWS. The backfill recovered only what the old `link`
  // encoded, and trade notifications encoded a chat partner. So rows written
  // before /api/v1 — TRADE_ACCEPTED in particular — carry ('user', <userId>)
  // rather than ('trade', <tradeId>). Deliberately not corrected: they are
  // already imperfect and they retire with the web user-side routes. Never read
  // a pre-v1 TRADE_* entityId as a trade id.
  //
  // `link` is still written and still read by the web admin. Unchanged.
  entityType String?
  entityId   String?

  userId  String
  user    User    @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actorId String?
  actor   User?   @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
}

model Review {
  id        String   @id @default(cuid())
  rating    Int
  comment   String?  @db.Text
  createdAt DateTime @default(now())

  reviewerId String
  reviewer   User   @relation("ReviewsGiven", fields: [reviewerId], references: [id])
  revieweeId String
  reviewee   User   @relation("ReviewsReceived", fields: [revieweeId], references: [id])

  tradeId String
  trade   TradeRequest @relation(fields: [tradeId], references: [id])

  @@unique([tradeId, reviewerId])
}

// Task reward system: one row per completed task.
// One-time tasks use refId "" (MySQL treats NULLs as distinct in unique
// indexes, so an empty-string default is what enforces once-per-user);
// repeatable tasks (VERIFIED_SWAP, SAFEZONE_MEETUP) use refId = tradeId.
// The @@unique below is what makes every award idempotent — do not relax it.
model TaskCompletion {
  id        String   @id @default(cuid())
  task      TaskKind
  refId     String   @default("")
  leaves    Int
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, task, refId])
  @@index([userId])
}

enum TaskKind {
  VERIFY_ACCOUNT
  COMPLETE_PROFILE
  FIRST_LISTING
  VERIFIED_SWAP
  SAFEZONE_MEETUP
}

model SwapConfirmationCode {
  id       String       @id @default(cuid())
  tradeId  String
  trade    TradeRequest @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  userId   String
  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash String
  used     Boolean      @default(false)

  // Wrong guesses against THIS code. A 6-digit code is a 1-in-a-million secret
  // only while the number of guesses is bounded; unbounded, a trade participant
  // can grind their partner's code and complete a "verified in-person swap"
  // without ever meeting — which is exactly what the VERIFIED_SWAP and
  // SAFEZONE_MEETUP Leaf awards are paid for. At MAX_CODE_ATTEMPTS the code is
  // burned and both parties have to restart.
  attempts Int @default(0)

  expiresAt DateTime
  createdAt DateTime @default(now())

  @@unique([tradeId, userId])
}

enum Category {
  ELECTRONICS
  CLOTHING
  BAGS
  BEAUTY
  ACCESSORIES
  FURNITURE
  BOOKS
  GAMING
  SPORTS
  BIKES
  TOYS
  TOOLS
  MUSIC
  ART
  COLLECTIBLES
  PETS
  PLANTS
  FOOD
  SERVICES
  OTHER
}

enum Condition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
  POOR
}

enum ItemStatus {
  AVAILABLE
  IN_TRADE
  TRADED
  OWNED
  REMOVED
}

enum TradeStatus {
  PENDING
  ACCEPTED
  CONFIRMING
  REJECTED
  COMPLETED
  CANCELLED
}

enum NotificationType {
  TRADE_REQUEST
  TRADE_ACCEPTED
  TRADE_REJECTED
  TRADE_COMPLETED
  TRADE_CANCELLED
  NEW_MESSAGE
  NEW_REVIEW
  FOLLOW_REQUEST
  FOLLOW_ACCEPTED
  // The outcome of a report the recipient filed. Google Play expects a reporter
  // to be told what happened, and /trust promises it in so many words.
  REPORT_RESOLVED
}

enum FollowStatus {
  PENDING
  ACCEPTED
}

model PostLike {
  id        String   @id @default(cuid())
  postId    String
  post      Item     @relation("ItemPostLikes", fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("UserPostLikes", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
}

model PostComment {
  id        String        @id @default(cuid())
  postId    String
  post      Item          @relation("ItemPostComments", fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation("UserPostComments", fields: [userId], references: [id], onDelete: Cascade)
  content   String        @db.Text
  parentId  String?
  parent    PostComment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies   PostComment[] @relation("CommentReplies")
  likes     CommentLike[]
  createdAt DateTime      @default(now())
}

model CommentLike {
  id        String      @id @default(cuid())
  commentId String
  comment   PostComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation("UserCommentLikes", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@unique([commentId, userId])
}

model Offer {
  id            String      @id @default(cuid())
  postId        String
  post          Item        @relation("ItemOffers", fields: [postId], references: [id], onDelete: Cascade)
  senderId      String
  sender        User        @relation("SentOffers", fields: [senderId], references: [id])
  receiverId    String
  receiver      User        @relation("ReceivedOffers", fields: [receiverId], references: [id])
  offeredItems  String      @db.Text
  offeredLeaves Int?
  message       String?     @db.Text
  status        OfferStatus @default(PENDING)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

enum OfferStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum LeafTxType {
  TRADE_SPEND
  TRADE_RECEIVE
  TASK_REWARD
  SIGNUP_GRANT
  // Deferred Points Agreement settlement. Always written as a PAIR in one
  // transaction -- CONTRACT_PAY on the debtor for -n, CONTRACT_COLLECT on the
  // creditor for +n -- so the pair nets to zero and
  // SUM(User.leaves) == SUM(LeafTransaction.amount) survives every payment.
  CONTRACT_PAY
  CONTRACT_COLLECT
}

// Each row is one atomic Leaf movement (credit or debit).
// Leaves are non-monetary. Two legitimate sources of a row:
//   - a completed trade settlement, which always writes a matching
//     TRADE_SPEND / TRADE_RECEIVE pair and nets to zero across users;
//   - a TASK_REWARD, written in the same transaction that increments both
//     leaves and lifetimeLeaves, and rate-limited by WEEKLY_TASK_LEAF_CAP.
//
// The two timestamps answer different questions and must not be conflated:
//   createdAt — when THIS ROW was written. Never backdated. For a backfill this
//               is the moment the backfill ran.
//   eventAt   — when the qualifying action actually happened (the trade
//               settling, the listing being posted). Equals createdAt on the
//               live path; for a backfilled award it is the historical event.
//
// WEEKLY_TASK_LEAF_CAP windows on eventAt, so an award is judged against the
// week it was earned in rather than the week it happened to be processed in.
model LeafTransaction {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        LeafTxType
  amount      Int // positive = credit, negative = debit (in Pasa Leaves)
  description String

  // Optional references to the trade/offer that caused this debit/credit
  offerId    String?
  tradeId    String?
  // The DeferredContract this row paid down, for CONTRACT_PAY / CONTRACT_COLLECT.
  // A plain column rather than a relation, matching offerId and tradeId above:
  // the ledger points at things, nothing points back at the ledger.
  contractId String?

  createdAt DateTime @default(now())
  eventAt   DateTime

  @@index([userId])
  @@index([userId, createdAt])
  @@index([userId, eventAt])
}

// ── Deferred Points Agreement ────────────────────────────────────────────────
//
// Two items are unequal in value. The party receiving the more valuable one
// agrees to owe the difference in Leaves and to settle it by a deadline.
//
// WHAT THIS MODEL DELIBERATELY CANNOT EXPRESS: getting the item back. There is
// no reversal state, no repossession field, no return flag. The item physically
// changed hands at a meetup and the system has no mechanism that could recover
// it — a status called RETURNED would be a lie the database told about the
// world. Every consequence of a default here is reputational (tier demotion,
// a public count) or access-based (blocked from initiating trades).
//
// DEBT SURVIVES DEFAULT. `status = DEFAULTED` does not zero amountPaidLeaves or
// close the contract: the remainder stays owed and auto-payment keeps applying
// to it. If defaulting wiped the balance, defaulting would be the cheap way to
// pay, and the deadline would be a suggestion.
model DeferredContract {
  id      String       @id @default(cuid())
  tradeId String
  trade   TradeRequest @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  // The debtor is always the PROPOSER. A contract is a promise to pay, and the
  // only person who can make it is the person who will owe it; the creditor's
  // half of the bargain is consent, which is what PENDING_ACCEPT is for.
  debtorId   String
  debtor     User   @relation("ContractDebtor", fields: [debtorId], references: [id], onDelete: Cascade)
  creditorId String
  creditor   User   @relation("ContractCreditor", fields: [creditorId], references: [id], onDelete: Cascade)

  /**
   * Principal. Never mutated after acceptance — payment moves amountPaidLeaves.
   */
  amountLeaves     Int
  /**
   * Paid so far. Two columns rather than a decrementing balance so that the
   * original size of the promise stays legible on a half-paid contract.
   */
  amountPaidLeaves Int @default(0)

  deadline DateTime
  status   ContractStatus @default(PENDING_ACCEPT)

  // Exactly one extension, and only if the creditor grants it. The request and
  // the grant are separate columns because they are separate acts by separate
  // people: a debtor asking is not a deadline moving.
  extensionUsed              Boolean   @default(false)
  extensionRequestedAt       DateTime?
  extensionRequestedDeadline DateTime?

  createdAt   DateTime  @default(now())
  acceptedAt  DateTime?
  fulfilledAt DateTime?
  // Stamped by the deadline sweep, and NEVER cleared — not even when a
  // defaulted contract is later paid off in full and moves to FULFILLED. This
  // column, not `status`, is what "past defaults" counts and what the tier
  // demotion is derived from. Paying late settles the debt, not the record.
  defaultedAt DateTime?

  // The debtor's exposure checks and the concurrency check both filter on
  // (debtorId, status); the creditor's list filters on (creditorId, status);
  // the lazy sweep filters on (status, deadline).
  @@index([debtorId, status])
  @@index([creditorId, status])
  @@index([status, deadline])
  @@index([tradeId])
}

enum ContractStatus {
  PENDING_ACCEPT
  ACTIVE
  FULFILLED
  DEFAULTED
  // Not in the original four. A creditor who refuses a proposal produces a row
  // that is neither fulfilled nor defaulted, and deleting it would erase the
  // one fact the preview screen exists to surface — that someone looked at this
  // debtor's numbers and said no. See the note in the change report.
  DECLINED
}

// ── Moderation: roles, reports, blocks, audit ────────────────────────────────
//
// Google Play's UGC policy requires in-app reporting and in-app blocking before
// a marketplace app passes review. That is why these four models exist now
// rather than later. It is not why they are shaped the way they are.

/**
 * Privilege. See the long note on User.role: nothing in the API writes it.
 *
 * MODERATOR and ADMIN are distinct even though every route below currently
 * accepts either. The split costs one enum value today and is the difference
 * between "revoke this person's moderation rights" and "there is one kind of
 * staff account" the first time somebody needs the former.
 */
enum Role {
  USER
  MODERATOR
  ADMIN
}

enum ReportTargetType {
  LISTING
  USER
  MESSAGE
}

/**
 * Why the reporter says the content is wrong.
 *
 * SCREAMING_SNAKE in the database, matching every other enum here, and the wire
 * carries the lower-case forms ("prohibited_item", "scam_or_fraud") through an
 * explicit closed map in @/lib/moderation. That is the same call
 * Item.valuationSource documents and for the same reason: a wire value
 * generated from a database enum name changes the day somebody renames the
 * enum, and a mobile client has already shipped against the old spelling.
 */
enum ReportCategory {
  SPAM
  PROHIBITED_ITEM
  SCAM_OR_FRAUD
  HARASSMENT
  COUNTERFEIT
  OTHER
}

/**
 * OPEN and REVIEWING are both LIVE -- see Report.openKey. ACTIONED and
 * DISMISSED are both RESOLVED, and the difference between them is whether
 * anything happened to the target, which is exactly what the reporter is told.
 */
enum ReportStatus {
  OPEN
  REVIEWING
  ACTIONED
  DISMISSED
}

/**
 * One user's claim that one piece of content breaks the rules.
 *
 * The target is a (type, id) pair rather than three nullable foreign keys.
 * Nullable FKs would give the database a shape it can check -- a real
 * constraint that the listing exists -- and that is a genuine loss, taken
 * deliberately: a report must survive its target. A scam listing that gets
 * deleted, by its owner or by us, is precisely the report a moderator still
 * needs to read, and an FK with ON DELETE CASCADE would erase the evidence at
 * the moment it started mattering. The route validates that the target exists
 * at report time; nothing keeps it alive afterwards, and nothing needs to.
 */
model Report {
  id String @id @default(cuid())

  reporterId String
  reporter   User   @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)

  targetType ReportTargetType
  targetId   String
  category   ReportCategory
  /** Free text from the reporter. Capped at MAX_REPORT_NOTES in @/lib/moderation. */
  notes      String?          @db.Text

  status ReportStatus @default(OPEN)

  /**
   * "One OPEN report per reporter per target" as a database constraint.
   *
   * MySQL treats NULLs as DISTINCT in a unique index -- the same property
   * TaskCompletion.refId leans on, inverted. This column holds the literal
   * "live" while the report is OPEN or REVIEWING and NULL once it is ACTIONED
   * or DISMISSED, so the @@unique below permits exactly one live report per
   * (reporter, target) and any number of resolved ones. Without it a reporter
   * who was told "no" could never report that target again, which is wrong: a
   * seller who cleans up a listing and re-posts the same violation next month
   * has committed a new violation.
   *
   * WRITTEN BY THE APPLICATION, in the same statement that sets `status`, and
   * never on its own -- see resolveReport() in @/lib/moderation, which is the
   * only code that moves either column. It was going to be a STORED generated
   * column, which cannot drift at all; MariaDB 10.4.32 hangs the entire server
   * on an UPDATE to a table with a stored generated column inside a unique
   * index (a leaked buf0flu latch that takes DICT_SYS down with it), so that
   * idea is recorded here as tried and rejected rather than left for the next
   * person to rediscover it the same way.
   */
  openKey String? @db.VarChar(4)

  /** Who closed it. SetNull rather than Cascade: the report outlives the staff account. */
  resolvedById String?
  resolvedBy   User?     @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt   DateTime?
  /** What the reporter is told. Goes verbatim into the REPORT_RESOLVED notification. */
  resolutionNote String? @db.Text

  createdAt DateTime @default(now())

  actions AdminAction[]

  @@unique([reporterId, targetType, targetId, openKey])
  // The queue: filtered by status, newest first.
  @@index([status, createdAt])
  // "everything ever filed against this listing" -- the report detail screen.
  @@index([targetType, targetId])
  @@index([reporterId])
}

/**
 * A one-way wall. blocker stops seeing, and stops being reachable by, blocked.
 *
 * ONE ROW, NOT TWO. A block is asymmetric as an act -- only the blocker chose it
 * and only the blocker can undo it -- and symmetric in effect, because every
 * enforcement point queries BOTH directions (blocksMade none + blocksReceived
 * none). Writing a mirror row would make "who blocked whom" unrecoverable,
 * which is the one fact a moderator reading a harassment report needs.
 *
 * WHAT A BLOCK DOES NOT DO: cancel a trade, void a DeferredContract, or delete
 * a message. See the note above enforceNotBlocked() in @/lib/blocking -- a
 * block that could rewind an obligation would be a debtor's escape hatch from
 * a creditor, and the block button is not a contract-reversal button.
 */
model Block {
  id String @id @default(cuid())

  blockerId String
  blocker   User   @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User   @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  // Every feed query asks "has anyone blocked me?", which reads this side.
  @@index([blockedId])
}

enum AdminActionKind {
  REPORT_REVIEWING
  REPORT_DISMISSED
  REPORT_ACTIONED
  LISTING_HIDDEN
  LISTING_UNHIDDEN
  USER_SUSPENDED
  USER_UNSUSPENDED
}

enum AdminTargetType {
  REPORT
  LISTING
  USER
}

/**
 * The audit trail. Who did what, when, and why.
 *
 * Moderation without an audit row is indistinguishable from abuse: a suspended
 * user, a hidden listing and a dismissed report all look the same whether a
 * moderator followed the policy or settled a grudge, and the only difference
 * that can ever be recovered is the one that was written down at the time.
 *
 * `reason` is NOT NULL AND NOT DEFAULTED. Every route that writes one of these
 * requires the moderator to type it. An optional reason is a reason nobody
 * fills in.
 *
 * `actorId` has no onDelete, which on MySQL means RESTRICT: the database
 * refuses to delete a staff account that has moderated anything. Deleting a
 * moderator must not vacuum up the record of what they did.
 */
model AdminAction {
  id String @id @default(cuid())

  actorId String
  actor   User   @relation("AdminActor", fields: [actorId], references: [id])

  action     AdminActionKind
  targetType AdminTargetType
  targetId   String

  /** The report this action answers, when there is one. Bulk cleanup has none. */
  reportId String?
  report   Report? @relation(fields: [reportId], references: [id], onDelete: SetNull)

  reason String @db.Text
  /**
   * JSON snapshot of what changed -- prior item status, prior suspension dates,
   * the listing title as it read at takedown. A plain Text column and not a
   * relation, matching LeafTransaction.tradeId: the audit points at things,
   * nothing points back at the audit.
   */
  detail String? @db.Text

  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([targetType, targetId])
  @@index([createdAt])
}
